# Copy this file to .env and fill in the real values.
# NEVER commit .env — it holds secrets. (.env is in .gitignore.)

# 1. From the Discord Developer Portal (README step 1):
#    Your bot's token. Keep it secret — anyone with it controls the bot.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
#    Your application's client ID (General Information page).
DISCORD_CLIENT_ID=PASTE_YOUR_APPLICATION_ID_HERE

# 2. From your Supabase project (README step 3) — the SAME project
#    as the tracker website:
#    Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
#    The service_role key (NOT the anon key). It bypasses row-level
#    security, so it must only ever live on the server, in this file.
#    Never paste it into Discord or share it with anyone.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE
